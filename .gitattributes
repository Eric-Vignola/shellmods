# Normalise to LF in the repository. Without this, Git warns on every file in
# this tree, because the C++ sources are LF while MSBuild's own files are CRLF.
* text=auto eol=lf

# MSBuild and cmd genuinely want CRLF in the working tree. The .vcxproj files
# are generated by tools/gen_projects.py with CRLF; keeping that consistent
# means regenerating them produces no spurious diff.
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.props     text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ini       text eol=crlf

# Vendored third-party trees are left exactly as upstream published them, so
# that diffing against upstream stays meaningful.
vendor/**   -text

# Generated by symgen.exe; not tracked, but be explicit in case one is added.
*.sym       text eol=lf
