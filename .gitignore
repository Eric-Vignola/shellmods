# Build output. build/common.props is source and stays tracked.
build/Release/
build/Debug/
build/obj/
build/bin/

# Staged runtime layout. Everything here is either built or generated:
#   shellmods.exe, symgen.exe, msdia140.dll  <- build output
#   mods/*.dll                               <- build output
#   offsets/*.sym                            <- symgen.exe
# shellmods.ini is the exception: it is checked in as the default config.
dist/mods/
dist/offsets/
dist/*.exe
dist/*.dll
dist/*.pdb
dist/shellmods.log
dist/DISABLE
dist/storage/

# Visual Studio
.vs/
*.user
*.suo

# Local scratch copies of the config. shellmods.ini itself is checked in as the
# default; anything else in dist/ is either built or generated.
dist/*.defaults.ini
